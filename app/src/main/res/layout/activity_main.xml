<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@android:drawable/ic_menu_agenda"
            android:scaleType="fitCenter"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NxtBe Label Printer"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TSC TE244 OTG Utility"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSelectPdf"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Select Shipping PDF"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvFileInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No PDF file selected"
            android:textSize="13sp"
            android:textColor="#334155"
            android:layout_marginBottom="14dp" />

        <!-- লাইভ প্রিন্ট প্রিভিউ উইন্ডো -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Print Preview (Page 1):"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#475569"
            android:layout_marginBottom="4dp" />

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="180dp"
            android:layout_height="260dp"
            android:background="#E2E8F0"
            android:scaleType="fitCenter"
            android:padding="4dp"
            android:layout_marginBottom="14dp" />

        <!-- পেপার সাইজ ড্রপডাউন -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Paper Size:"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#475569"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spPaperSize"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pages to Print (e.g. 1-3 or 2 or leave empty for All):"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#475569"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etPageRange"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FFFFFF"
            android:hint="All pages (or type 1-5, 2, etc.)"
            android:padding="10dp"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnPrint"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Print Labels"
            android:textSize="16sp"
            android:enabled="false"
            android:textAllCaps="false"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="#2563EB" />

    </LinearLayout>
</ScrollView>
