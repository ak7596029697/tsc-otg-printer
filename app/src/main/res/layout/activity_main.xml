<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:src="@android:drawable/ic_menu_agenda"
            android:scaleType="fitCenter"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NxtBe Label Printer"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TSC TE244 OTG Utility"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnSelectPdf"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Select Shipping PDF"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvFileInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No PDF file selected"
            android:textSize="13sp"
            android:textColor="#334155"
            android:layout_marginBottom="12dp" />

        <!-- প্রিভিউ সেকশন -->
        <TextView
            android:id="@+id/tvPreviewTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Print Preview:"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#475569"
            android:layout_marginBottom="4dp" />

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="180dp"
            android:layout_height="250dp"
            android:background="#E2E8F0"
            android:scaleType="fitCenter"
            android:padding="4dp"
            android:layout_marginBottom="8dp" />

        <!-- পেজ বদলানোর বাটন -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/btnPrevPage"
                android:layout_width="85dp"
                android:layout_height="40dp"
                android:text="Previous"
                android:textSize="11sp"
                android:enabled="false"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/tvPageIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Page 0/0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#1E293B"
                android:paddingHorizontal="14dp" />

            <Button
                android:id="@+id/btnNextPage"
                android:layout_width="85dp"
                android:layout_height="40dp"
                android:text="Next"
                android:textSize="11sp"
                android:enabled="false"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- স্ক্রিনে বড় ও স্পষ্ট সাইজ দেখানোর ব্যানার -->
        <TextView
            android:id="@+id/tvCurrentPaperSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#16A34A"
            android:text="Active Label: 3x5 inch (75x125 mm)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="10dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Paper Size (Auto-Saved):"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#475569"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spPaperSize"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pages to Print (e.g. 1-3 or 2 or leave empty for All):"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#475569"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etPageRange"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="#FFFFFF"
            android:hint="All pages (or type 1-5, 2, etc.)"
            android:padding="10dp"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnPrint"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Print Labels"
            android:textSize="16sp"
            android:enabled="false"
            android:textAllCaps="false"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="#2563EB" />

    </LinearLayout>
</ScrollView>
