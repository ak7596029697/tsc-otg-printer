<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- হেডার -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Flipkart Thermal Label Printer"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- বর্তমান সিলেক্টেড সাইজের স্পষ্ট বড় স্ট্যাটাস -->
        <TextView
            android:id="@+id/tvCurrentPaperSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2E7D32"
            android:text="Active Label: 3 x 5 inch"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <!-- পেপার সাইজ ড্রপডাউন লেবেল -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Paper Size (Auto-Saved):"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <!-- ড্রপডাউন স্পিনার -->
        <Spinner
            android:id="@+id/spinnerPaperSize"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:drawable/btn_dropdown"
            android:layout_marginBottom="16dp" />

        <!-- PDF সিলেক্ট বাটন -->
        <Button
            android:id="@+id/btnSelectPdf"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Select Flipkart Label (PDF)"
            android:backgroundTint="#0288D1"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- পেজ ইনপুট অপশন -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Page No: "
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPageNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="1"
                android:gravity="center" />
        </LinearLayout>

        <!-- লেবেল প্রিভিউ ইমেজ -->
        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="#E0E0E0"
            android:scaleType="fitCenter"
            android:contentDescription="Print Preview"
            android:layout_marginBottom="16dp" />

        <!-- প্রিন্ট বাটন -->
        <Button
            android:id="@+id/btnPrint"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="PRINT TO TSC TE244"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
